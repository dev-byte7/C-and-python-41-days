#include <stdio.h>

// add function
int add(int a, int b) {
    return a + b;
}

// factorial function
int factorial(int n) {
    if (n == 0 || n == 1) return 1;
    int fact = 1;
    for (int i = 2; i <= n; i++) 
fact *= i;
    return fact;
}

int main() {
    printf("Add: %d\n", add(5, 7));
    printf("Factorial 5: %d\n", factorial(5));
    return 0;
}
